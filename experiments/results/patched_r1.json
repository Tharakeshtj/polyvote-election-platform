{
  "tag": "patched_r1",
  "prevention": [
    {
      "id": "A1",
      "attack": "Mark an already-voted voter as voted again",
      "expected": "trigger",
      "outcome": "prevented",
      "detail": "DBMS Trigger Violation: Voter has already submitted a ballot."
    },
    {
      "id": "A2",
      "attack": "Insert a rank outside 1-3 (rank 4)",
      "expected": "CHECK",
      "outcome": "prevented",
      "detail": "CHECK constraint failed: preference_rank BETWEEN 1 AND 3"
    },
    {
      "id": "A3",
      "attack": "Rank the same candidate twice on one ballot",
      "expected": "composite PK",
      "outcome": "prevented",
      "detail": "UNIQUE constraint failed: BALLOT_RANKS.ballot_token, BALLOT_RANKS.candidate_id"
    },
    {
      "id": "A4",
      "attack": "Rank a candidate that does not exist (FK enforcement on)",
      "expected": "FK",
      "outcome": "prevented",
      "detail": "FOREIGN KEY constraint failed"
    },
    {
      "id": "A5",
      "attack": "Rank a nonexistent candidate from a default connection (FK pragma off)",
      "expected": "FK",
      "outcome": "not_prevented",
      "detail": "statement succeeded"
    },
    {
      "id": "A6",
      "attack": "Register the same reg. number twice in one election",
      "expected": "UNIQUE",
      "outcome": "prevented",
      "detail": "UNIQUE constraint failed: VOTER_PARTICIPATION.student_reg_no, VOTER_PARTICIPATION.election_id"
    },
    {
      "id": "A7",
      "attack": "Set has_voted to an invalid value (2)",
      "expected": "CHECK",
      "outcome": "prevented",
      "detail": "CHECK constraint failed: has_voted IN (0, 1)"
    }
  ],
