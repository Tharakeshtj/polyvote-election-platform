  "otp": [
    {
      "id": "F1",
      "test": "Correct password alone does not create a voting session",
      "expected": "no token issued; challenge id is not a session",
      "outcome": "passed",
      "detail": "login 200, challenge used as bearer: 401"
    },
    {
      "id": "F2",
      "test": "Correct emailed code unlocks the ballot",
      "expected": "session issued, ballot accepted",
      "outcome": "passed",
      "detail": "verify 200, cast 200"
    },
    {
      "id": "F3",
      "test": "A used code cannot be replayed",
      "expected": "rejected (410)",
      "outcome": "passed",
      "detail": "HTTP 410"
    },
    {
      "id": "F4",
      "test": "Three wrong codes lock the challenge",
      "expected": "401, 401, 410 then the right code is refused",
      "outcome": "passed",
      "detail": "[401, 401, 410], then correct code: 410"
    },
    {
      "id": "F5",
      "test": "An expired code is refused",
      "expected": "rejected (410)",
      "outcome": "passed",
      "detail": "HTTP 410"
    },
    {
      "id": "F6",
      "test": "Resend is rate-limited to one per 30 seconds",
      "expected": "immediate resend 429, later resend 200",
      "outcome": "passed",
      "detail": "429 then 200"
    },
    {
      "id": "F7",
      "test": "A resent code invalidates the previous one",
      "expected": "old code rejected",
      "outcome": "passed",
      "detail": "old code: HTTP 401"
    },
    {
      "id": "F8",
      "test": "A challenge allows at most 5 codes",
      "expected": "sixth send refused (429)",
      "outcome": "passed",
      "detail": "HTTP 429"
    },
    {
      "id": "F9",
      "test": "A voter with no email on file cannot proceed",
      "expected": "409 with a clear message",
      "outcome": "passed",
      "detail": "HTTP 409"
    },
    {
      "id": "F10",
      "test": "Plaintext codes are absent from the verification database",
      "expected": "code not found in any table",
      "outcome": "passed",
      "detail": "checked OTP_CHALLENGE, MAIL_LOG, VOTER_CONTACT"
    },
    {
      "id": "F11",
      "test": "Repeated sign-ins are rate-limited",
      "expected": "sixth challenge in 15 min refused (429)",
      "outcome": "passed",
      "detail": "[200, 200, 200, 200, 200, 429, 429]"
    },
    {
      "id": "F12",
      "test": "Codes are 6 digits including leading zeros",
      "expected": "all length 6, mostly distinct",
      "outcome": "passed",
      "detail": "4991 distinct of 5000"
    },
    {
      "id": "F13",
      "test": "A failed email send does not break sign-in",
      "expected": "challenge still issued; failure logged; code stays in the outbox",
      "outcome": "passed",
      "detail": "login 200, mail status \"failed: ConnectionRefusedError\""
    },
    {
      "id": "F14",
      "test": "Voter email is not stored in the election database",
      "expected": "no email column in any election table",
      "outcome": "passed",
      "detail": "election tables: ['ADMIN_USERS', 'BALLOT_RANKS', 'CANDIDATE', 'ELECTION', 'ORGANIZATION', 'VOTER_PARTICIPATION', 'sqlite_sequence']"
    }
  ],
