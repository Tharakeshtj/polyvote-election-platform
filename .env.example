# Copy this file to .env and fill in your own values. .env is git-ignored.

# Ledger storage (leave unset to use the local JSON file)
MONGO_URI=mongodb+srv://polyvote:YOURPASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional: keyed (HMAC) ledger chain. Keep this secret outside the database and ledger store.
# If you already have blocks written without a key, set LEDGER_LEGACY_UNTIL to the last such block's index.
LEDGER_KEY=
LEDGER_LEGACY_UNTIL=0

# Email one-time code at voter sign-in (the Mail outbox page in the admin console shows every code)
OTP_REQUIRED=false
# Real email. Gmail needs 2-step verification on and an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: the public link the voter-page QR code should point at
PUBLIC_URL=
# Optional: replace the default admin password
ADMIN_PASSWORD=
